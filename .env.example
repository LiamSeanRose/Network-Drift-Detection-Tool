# .env.example — copy to .env and fill in. docker-compose reads these at
# `docker compose up`. The real .env is gitignored; never commit tokens.
#
#   cp .env.example .env

# --- Database -------------------------------------------------------------
# Postgres password for the compose stack. Required — `docker compose up`
# aborts if this is unset. Use a strong value; do not ship a default.
POSTGRES_PASSWORD=

# --- NetBox (source of truth) ---------------------------------------------
# The scheduler reads intent from NetBox. Inside a container, the host is
# reachable as host.docker.internal (NOT localhost).
NETBOX_URL=http://host.docker.internal:8000
NETBOX_TOKEN=

# --- Auto-remediation (v2.5 / v3.0) ---------------------------------------
# Global kill-switch. Must be "true" before ANY auto-apply can run. The
# per-issue auto_apply_enabled flag and the per-device pause
# (PATCH /devices/{name}/auto-apply) still apply on top of this.
AUTO_REMEDIATION_ENABLED=false

# --- Webhooks (v3.0) ------------------------------------------------------
# Outbound notification endpoint (Slack/PagerDuty/etc.). Leave empty to
# disable webhooks entirely — no dispatch, no error.
WEBHOOK_URL=

# Comma-separated event types to dispatch. Valid values: critical_drift,
# apply_success, apply_failure, sla_breached, sla_resolved, device_unreachable.
# SLA alerting is edge-triggered: sla_breached fires once when a breach starts,
# sla_resolved once when the drift clears — not every poll cycle.
WEBHOOK_EVENTS=critical_drift,apply_success,apply_failure

# Allow webhook URLs that point at private/loopback addresses (e.g. an on-prem
# Slack or a sidecar receiver). Default false rejects them as an SSRF guard.
WEBHOOK_ALLOW_PRIVATE=false

# --- AI drift explanations (AI1) ------------------------------------------
# Opt-in natural-language root-cause hints, layered on top of the deterministic
# diagnose.py table. OFF by default: with no provider set, netdrift never makes
# an LLM call and uses the deterministic hint. Read-only, generated once per
# drift fingerprint — never on a page-load path.
#
# Provider: "off" (default), "ollama" (local model, recommended), or "openai"
# (an OpenAI-compatible endpoint — bring your own key).
NETDRIFT_EXPLAIN_PROVIDER=off
# Model name. Defaults: ollama -> llama3.2:3b, openai -> gpt-4o-mini.
NETDRIFT_EXPLAIN_MODEL=
# Endpoint base URL. Defaults: ollama -> http://localhost:11434,
# openai -> https://api.openai.com/v1.
NETDRIFT_EXPLAIN_URL=
# API key for a hosted (openai-compatible) provider. Leave empty for local ollama.
NETDRIFT_EXPLAIN_API_KEY=

# --- API authentication ---------------------------------------------------
# Mutating endpoints (POST/PUT/PATCH/DELETE — every dashboard button) require a
# valid X-API-Key by default; read-only GETs are public. Set this to true ONLY
# on a trusted/local network to drop that requirement so the dashboard's actions
# work without pasting a key in each browser. NEVER set it on a public instance:
# the mutating routes can push config to live devices. Default (unset) = auth on.
NETDRIFT_DISABLE_API_AUTH=

# --- Fuzzy fingerprint matching (v5.0) ------------------------------------
# Off by default: a drift matches a known issue only on an exact fingerprint
# (match_confidence 1.0). Set true to also surface a known fix for a
# structurally similar drift, with match_confidence between 0 and 1.
FUZZY_MATCHING_ENABLED=
# Similarity at/above which a fuzzy match is accepted (0–1). Default 0.7; tune it
# against your labeled corpus with `driftcheck eval-fuzzy <corpus.json>`.
FUZZY_MATCH_THRESHOLD=

# --- CORS (SEC1) ----------------------------------------------------------
# Comma-separated list of exact browser origins allowed to call the API
# cross-origin (e.g. https://dashboard.example.com). Leave empty for
# same-origin only (the default). A wildcard "*" is intentionally refused
# while the API ships without auth on GET requests.
CORS_ALLOW_ORIGINS=
